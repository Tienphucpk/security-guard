# Application Environment Configuration Example
# Copy this file to .env and adjust values for your environment.
# DO NOT COMMIT REAL PASSWORDS OR SECRETS TO VERSION CONTROL.

# Environment Mode
NODE_ENV=development

# Web Application Settings
WEB_PORT=3000
WEB_HOST=0.0.0.0

# Detection Engine Settings
DETECTION_ENGINE_PORT=5000
DETECTION_ENGINE_HOST=0.0.0.0
DETECTION_ENGINE_URL=http://localhost:5000

# Dashboard Settings
DASHBOARD_PORT=5173
VITE_API_URL=http://localhost:3000
VITE_ENGINE_URL=http://localhost:5000

# Database Configuration (PostgreSQL)
# Use 'localhost' for Native Windows mode, or 'database' for Docker Compose mode
DB_HOST=localhost
DB_PORT=5432
DB_NAME=security_guard
DB_USER=security_guard
DB_PASSWORD=change_me

# Compatibility aliases
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=security_guard
DATABASE_USER=security_guard
DATABASE_PASSWORD=change_me

# Logging Settings
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_FILE_PATH=./logs/requests.log

# Phase 6 Machine Learning Anomaly Detection Settings
DETECTION_ML_MODE=shadow            # Options: 'shadow' (default evaluation mode), 'active' (generates ML_ANOMALY alerts), 'disabled'
ML_DEDUP_WINDOW_MS=60000            # Deduplication window for ML anomaly alerts in milliseconds (default: 60s)

# Phase 9 Alert Management Authentication & Role-Based Authorization
ALERT_ADMIN_KEY=your_admin_secret_key_here
ALERT_OPERATOR_KEY=your_operator_secret_key_here
ALERT_VIEWER_KEY=your_viewer_secret_key_here
AUTH_SECRET_KEY=your_signing_secret_key_here
VITE_ADMIN_KEY=your_admin_secret_key_here
